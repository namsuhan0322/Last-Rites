{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "eb6e06890ffc41c09b3b4c1d3bdd7442",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ReconstructWorldFromRawDepth (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 9369.0,
            "y": 745.0000610351563,
            "width": 345.0,
            "height": 301.99993896484377
        }
    },
    "m_Slots": [
        {
            "m_Id": "27c5307ebad543b9b22ca6057424265a"
        },
        {
            "m_Id": "219c78a4fd584fc7807941e21b08d56f"
        },
        {
            "m_Id": "3c1254eb13cf4f16b84711ffc6d2fbdd"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "ReconstructWorldFromRawDepth",
    "m_FunctionSource": "d009ade0ca610094d8e3f011191e1ae8",
    "m_FunctionBody": "// String mode body (no #include here)\r\nvoid ReconstructWorldFromRawDepth_float(float2 uv01, float rawDepth, out float3 worldPos)\r\n{\r\r\n    // NDC (-1..1)\r\n    float4 clip = float4(uv01 * 2.0 - 1.0, rawDepth, 1.0);\r\n\r\n    // Inverse View-Projection to world\r\n    float4 wpos = mul(UNITY_MATRIX_I_VP, clip);\r\n    worldPos = wpos.xyz / max(wpos.w, 1e-6);\r\n}\r\n"
}

