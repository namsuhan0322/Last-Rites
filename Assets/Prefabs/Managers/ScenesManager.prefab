  loadingTips:
  - targetSceneName: LobbyScene
    loadingImage: {fileID: 21300000, guid: ce3d6abfaa8129a4e998d53d1b1a0d9e, type: 3}
    loadingDescription: "\uC0AC\uD22C\uB97C \uC900\uBE44\uD558\uB294 \uC548\uC804\uC9C0\uB300\uC785\uB2C8\uB2E4.
      \uD68D\uB4DD\uD55C \uC7AC\uD654\uB85C \uBB34\uAE30\uB97C \uAC15\uD654 \uBC0F
      \uC7AC\uB828\uD558\uACE0, \uC55E\uC73C\uB85C \uB9C8\uC8FC\uD560 \uC801\uC5D0\uAC8C
      \uAC00\uC7A5 \uC801\uD569\uD55C \uBB34\uAE30\uB85C \uAD50\uCCB4\uD558\uC5EC
      \uD0DC\uC138\uB97C \uC815\uBE44\uD558\uC2ED\uC2DC\uC624."
  - targetSceneName: TowerScene
    loadingImage: {fileID: 21300000, guid: 5331888d804db144cab4cee3a0dccc0d, type: 3}
    loadingDescription: "\uCE35\uC744 \uC624\uB974\uBA70 \uC804\uD22C\uB97C \uCE58\uB974\uACE0
      \uC7AC\uD654\uB97C \uD68D\uB4DD\uD558\uB294 \uD30C\uBC0D \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
      \uD68D\uB4DD\uD55C \uC7AC\uD654\uB294 \uB85C\uBE44\uC5D0\uC11C \uC7A5\uBE44\uB97C
      \uC131\uC7A5\uC2DC\uD0A4\uB294 \uB370 \uAF2D \uD544\uC694\uD55C \uBC11\uAC70\uB984\uC774
      \uB429\uB2C8\uB2E4."
  - targetSceneName: BossRushScene
    loadingImage: {fileID: 21300000, guid: c05c6c7a1ab425346a0950dc2b60133f, type: 3}
    loadingDescription: "\uC274 \uD2C8 \uC5C6\uC774 \uBC00\uB824\uC624\uB294 \uAC15\uC801\uB4E4\uACFC\uC758
      \uC5F0\uC18D \uC804\uD22C\uC785\uB2C8\uB2E4. \uC774\uC804 \uC804\uD22C\uC758
      \uC0C1\uCC98\uAC00 \uC544\uBB3C\uAE30\uB3C4 \uC804\uC5D0 \uB2E4\uC74C \uC2DC\uB828\uC774
      \uCC3E\uC544\uC635\uB2C8\uB2E4."
  - targetSceneName: Thema1Scene
    loadingImage: {fileID: 21300000, guid: 0d188795d063f8d4e827fa388bc32aea, type: 3}
    loadingDescription: "\uB0A0\uB835\uD558\uACE0 \uD749\uD3EC\uD55C '\uB291\uB300
      \uBCF4\uC2A4'\uB97C \uD1A0\uBC8C\uD558\uB294 \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
      \uC9D0\uC2B9\uC758 \uBE60\uB974\uACE0 \uBCC0\uCE59\uC801\uC778 \uC5F0\uC18D
      \uACF5\uACA9\uC744 \uB05D\uAE4C\uC9C0 \uAD00\uCC30\uD558\uACE0, \uD68C\uD53C\uC758
      \uBB34\uC801 \uC2DC\uAC04\uC744 \uD65C\uC6A9\uD574 \uBC18\uACA9\uD558\uC2ED\uC2DC\uC624."
  - targetSceneName: Thema2Scene
    loadingImage: {fileID: 21300000, guid: a6ddeefebb81ccb43aff115a6a882fa7, type: 3}
    loadingDescription: "\uC555\uB3C4\uC801\uC778 \uCCB4\uAE09\uC744 \uC790\uB791\uD558\uB294
      '\uBE59\uACB0\uC758  \uBCF4\uC2A4'\uB97C \uD1A0\uBC8C\uD558\uB294 \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
      \uAC70\uB300\uD55C \uACF5\uACA9 \uBC94\uC704\uC640 \uCE58\uBA85\uC801\uC778
      \uBE0C\uB808\uC2A4\uB97C \uD53C\uD558\uB824\uBA74 \uACFC\uAC10\uD558\uAC8C
      \uD488\uC73C\uB85C \uD30C\uACE0\uB4E4\uC5B4\uC57C \uD569\uB2C8\uB2E4."
